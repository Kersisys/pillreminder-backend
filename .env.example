# Скопируйте в .env (локально) или задайте те же переменные в панели хостинга
# (Railway / Render / Vercel -> Environment Variables). Значения БЕЗ кавычек.

# Строка подключения PostgreSQL (для Neon на Vercel — pooled-адрес)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Любая случайная строка, минимум 16 символов
JWT_SECRET=замените-на-длинную-случайную-строку

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Необязательно: на Railway/Render подставляется автоматически
PORT=3000

# Необязательно: без него сервер работает, но push-уведомления не отправляются
# (base64 от service-account.json из Firebase Console)
FIREBASE_SERVICE_ACCOUNT_BASE64=
